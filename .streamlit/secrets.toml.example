# Sign-in settings for INSIGHTSQL_AUTH=oidc. Copy this file to .streamlit/secrets.toml (which
# Git ignores) and fill it in. Never commit the real file: it holds your client secrets.

[auth]
# The address of your app followed by /oauth2callback. Register exactly this address as an
# "authorized redirect URI" with your provider. Use https for anything but localhost.
redirect_uri = "http://localhost:8501/oauth2callback"
# A long random value that signs the sign-in cookie. Create one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
cookie_secret = ""

# Google: https://console.cloud.google.com/apis/credentials → Create credentials → OAuth client ID
# → Web application.
[auth.google]
client_id = ""
client_secret = ""
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# Microsoft (Entra ID): https://entra.microsoft.com → App registrations → New registration.
# Replace <tenant-id> with your directory (tenant) id; add the optional "email" claim to the ID
# token (Token configuration), because InsightSQL identifies people by email. Remove this
# section if you only use Google.
# [auth.microsoft]
# client_id = ""
# client_secret = ""
# server_metadata_url = "https://login.microsoftonline.com/<tenant-id>/v2.0/.well-known/openid-configuration"
