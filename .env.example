# Copy this file to .env and adjust. Never commit .env (it is git-ignored).

# Path to the SQLite database (created by scripts/seed_database.py).
INSIGHTSQL_DB_PATH=data/insightsql.db

# --- Optional: AI Mode -----------------------------------------------------------
# Demo Mode works without any of these settings, without network access.
# Only your question and the table structure are sent to the AI service, never the data.

# Which AI service AI Mode uses: gemini (default) or huggingface.
AI_PROVIDER=gemini

# Google Gemini. Create a key at https://aistudio.google.com/apikey and paste it below.
GEMINI_API_KEY=
# Current models: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.5-flash-lite
# Seconds to wait for the model to answer.
GEMINI_TIMEOUT_SECONDS=30
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com   (default; must be https)

# Hugging Face Inference Providers (only used when AI_PROVIDER=huggingface).
# Token: https://huggingface.co/settings/tokens, permission "Make calls to Inference Providers".
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct
HF_TIMEOUT_SECONDS=30
