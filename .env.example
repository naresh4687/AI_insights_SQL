# Copy this file to .env and adjust. Never commit .env (it is git-ignored).

# Path to the SQLite database (created by scripts/seed_database.py).
INSIGHTSQL_DB_PATH=data/insightsql.db
# App metadata (dataset catalog). Separate from the demo database, which reseeding deletes.
INSIGHTSQL_APP_DB_PATH=data/app.db
# Imported and synchronised datasets (used from the data-import phase onwards).
INSIGHTSQL_DATASETS_DB_PATH=data/datasets.db
# Original uploaded files are kept unchanged here (one folder per dataset).
INSIGHTSQL_UPLOADS_DIR=data/uploads
# Import limits. Raising the file size also needs [server] maxUploadSize in .streamlit/config.toml.
INSIGHTSQL_IMPORT_MAX_MB=25
INSIGHTSQL_IMPORT_MAX_ROWS=200000
INSIGHTSQL_IMPORT_MAX_COLUMNS=200
# --- Server connections (PostgreSQL, MySQL, REST APIs) --------------------------------
# Encrypts saved passwords and tokens. Create one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it secret and keep a copy: without it, saved connection secrets cannot be read.
INSIGHTSQL_SECRET_KEY=
# Connections may only reach public addresses. To allow a server on this machine or your
# private network, list it exactly, e.g. localhost:5432,db.internal:3306 (cloud metadata
# addresses are always blocked).
INSIGHTSQL_ALLOWED_PRIVATE_HOSTS=
INSIGHTSQL_CONNECTOR_TIMEOUT_SECONDS=15
# --- Refresh (scripts/refresh_worker.py runs scheduled refreshes) ------------------------
INSIGHTSQL_REFRESH_MAX_ATTEMPTS=3
INSIGHTSQL_REFRESH_RETRY_SECONDS=30
# DEBUG, INFO, WARNING (default), ERROR or CRITICAL. Secrets are redacted from log output.
INSIGHTSQL_LOG_LEVEL=WARNING

# --- Optional: user accounts (sign-in) ------------------------------------------
# none (default): no sign-in, one local user with full rights. Use it ONLY when the app is
# reachable from this computer alone. oidc: everyone signs in with Google / Microsoft; also
# fill in .streamlit/secrets.toml (copy .streamlit/secrets.toml.example).
INSIGHTSQL_AUTH=none
# Always administrators when they sign in (comma-separated).
INSIGHTSQL_ADMIN_EMAILS=
# Who may sign in without an invitation: emails and/or whole domains such as @example.com.
# Empty: only administrators and people an administrator invites.
INSIGHTSQL_ALLOWED_SIGNINS=
# Role for people let in by INSIGHTSQL_ALLOWED_SIGNINS: viewer (default) or editor.
INSIGHTSQL_DEFAULT_ROLE=viewer

# --- Optional: AI Mode -----------------------------------------------------------
# Demo Mode works without any of these settings, without network access.
# Only your question and the table structure are sent to the AI service, never the data.

# Which AI service AI Mode uses: gemini (default) or huggingface.
AI_PROVIDER=gemini

# Google Gemini. Create a key at https://aistudio.google.com/apikey and paste it below.
GEMINI_API_KEY=
# Current models: https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.5-flash-lite
# Seconds to wait for the model to answer.
GEMINI_TIMEOUT_SECONDS=30
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com   (default; must be https)

# Hugging Face Inference Providers (only used when AI_PROVIDER=huggingface).
# Token: https://huggingface.co/settings/tokens, permission "Make calls to Inference Providers".
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct
HF_TIMEOUT_SECONDS=30
